{
  "name": "manifold-api",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "description": "KRL rulesets for Manifold on Pico Engine 1.8+",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "generate:docs": "node tools/generate-docs.cjs",
    "check:schema-docs": "node tools/check-schema-docs.cjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "tsx t/run.ts",
    "test:parse": "tsx t/parse.ts",
    "test:keep": "tsx t/run.ts --keep",
    "test:cleanup": "tsx t/cleanup.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "krl-compiler": "^1.5.0",
    "minimatch": "^10.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
